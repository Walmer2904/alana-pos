rules_version = '2';

// ============================================================
// Reglas de seguridad de Cloud Firestore — ALANA POS
// Pegar completas en: Firebase > Firestore Database > Reglas > Publicar
//
// Roles:
//  - admin  : documento usuarios/{uid} con rol "admin".
//  - cajero : cualquier otro usuario logueado (rol "cajero" o sin documento).
// La interfaz oculta lo que el cajero no puede hacer, pero la seguridad
// REAL está aquí: estas reglas bloquean también lo que se intente desde
// la consola del navegador.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿Hay sesión iniciada?
    function logueado() {
      return request.auth != null;
    }

    // ¿El usuario logueado tiene rol "admin" en la colección usuarios?
    function esAdmin() {
      return logueado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // DNI válido: exactamente 8 números y no todos iguales (00000000, 11111111…).
    function dniOk(dni) {
      return dni is string
        && dni.matches('^[0-9]{8}$')
        && !(dni in ['00000000', '11111111', '22222222', '33333333', '44444444',
                     '55555555', '66666666', '77777777', '88888888', '99999999']);
    }

    // Id de la caja abierta en este momento (config/cajaActual).
    function cajaAbiertaId() {
      return get(/databases/$(database)/documents/config/cajaActual).data.cierreId;
    }

    // Perfiles: cada uno lee el suyo; el admin lee todos.
    // Se crean/editan solo desde la consola de Firebase.
    match /usuarios/{uid} {
      allow read: if logueado() && (request.auth.uid == uid || esAdmin());
      allow write: if false;
    }

    // Productos: todos los logueados leen (el cajero los necesita para vender);
    // solo el admin crea, edita, desactiva o elimina.
    // Excepción para vender bebidas (productos con manejaStock): el cajero puede
    // actualizar SOLO el campo stock (y actualizadoEn), SOLO para bajarlo y sin
    // dejarlo negativo. Subir el stock (ingresos, ajustes, devolver al anular)
    // es solo del admin.
    match /productos/{id} {
      allow read: if logueado();
      allow create, delete: if esAdmin();
      allow update: if esAdmin() || (
        logueado()
        && resource.data.get('manejaStock', false) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'actualizadoEn'])
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
      );
    }

    // Movimientos de stock de productos (ingreso, venta, anulacion, ajuste).
    // El cajero solo crea movimientos de tipo "venta" (cantidad negativa, hora
    // del servidor) al vender; el resto solo el admin. Nunca se modifican ni borran.
    match /movimientosStock/{id} {
      allow read: if esAdmin();
      allow create: if esAdmin() || (
        logueado()
        && request.resource.data.tipo == 'venta'
        && request.resource.data.cantidad is number
        && request.resource.data.cantidad < 0
        && request.resource.data.fecha == request.time
      );
      allow update, delete: if false;
    }

    // Ventas:
    //  - Admin: crea cualquier venta (incluidas las manuales o de fechas pasadas).
    //  - Cajero: solo ventas normales: no manuales, con la hora del servidor,
    //    sin anular y en la caja abierta actual.
    //  - Anular o editar (update): solo admin. Borrar: nunca.
    match /ventas/{id} {
      allow read: if logueado();
      allow create: if esAdmin() || (
        logueado()
        && request.resource.data.get('registroManual', false) != true
        && request.resource.data.fecha == request.time
        && request.resource.data.anulada == false
        && request.resource.data.cierreId is string
        && request.resource.data.cierreId == cajaAbiertaId()
      );
      allow update: if esAdmin();
      allow delete: if false;
    }

    // Cierres de caja:
    //  - Crear (abrir caja): cualquier logueado, siempre con estado "abierta".
    //  - Actualizar: el cajero solo puede CERRAR una caja abierta
    //    ("abierta" -> "cerrada"). Un cierre ya cerrado solo lo toca el admin.
    //  - Leer: el cajero solo el cierre abierto; el admin todo el historial.
    match /cierres/{id} {
      allow read: if esAdmin() || (logueado() && resource.data.estado == 'abierta');
      allow create: if logueado() && request.resource.data.estado == 'abierta';
      allow update: if esAdmin() || (
        logueado()
        && resource.data.estado == 'abierta'
        && request.resource.data.estado == 'cerrada'
      );
      allow delete: if esAdmin();
    }

    // config/cajaActual guarda el id de la caja abierta para que las 2 PCs
    // compartan una sola caja. Todos lo leen y lo actualizan al abrir/cerrar
    // caja (siempre dentro de transacciones); nadie lo borra.
    match /config/{id} {
      allow read: if logueado();
      allow create, update: if logueado();
      allow delete: if false;
    }

    // Créditos (ventas fiadas): son el respaldo ante reclamos, NUNCA se borran.
    //  - Crear: con DNI válido, pendiente, sin pagos y saldo = total.
    //    El cajero además solo con la hora del servidor (no fechas pasadas).
    //  - Admin: puede actualizar (anular, corregir) si el DNI no cambia o es válido.
    //  - Cajero: solo registrar UN pago por vez: cambia únicamente saldoPendiente,
    //    pagos, estado y fechaPago; el saldo baja; el estado pasa de "pendiente"
    //    a "pendiente" o "pagado" (nunca "anulado"); no toca total, items, DNI ni nombre.
    match /creditos/{id} {
      allow read: if logueado();
      allow create: if logueado()
        && dniOk(request.resource.data.dni)
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.pagos.size() == 0
        && request.resource.data.saldoPendiente == request.resource.data.total
        && (esAdmin() || request.resource.data.fecha == request.time);
      allow update: if (
          esAdmin()
          && (request.resource.data.dni == resource.data.dni || dniOk(request.resource.data.dni))
        ) || (
          logueado()
          && resource.data.estado == 'pendiente'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['saldoPendiente', 'pagos', 'estado', 'fechaPago'])
          && request.resource.data.estado in ['pendiente', 'pagado']
          && request.resource.data.saldoPendiente is number
          && request.resource.data.saldoPendiente >= 0
          && request.resource.data.saldoPendiente < resource.data.saldoPendiente
          && (request.resource.data.estado == 'pendiente' || request.resource.data.saldoPendiente == 0)
          && request.resource.data.pagos.size() == resource.data.pagos.size() + 1
        );
      allow delete: if false;
    }

    // Clientes (ID del documento = DNI válido). Nunca se borran.
    match /clientes/{dni} {
      allow read: if logueado();
      allow create, update: if logueado()
        && dniOk(request.resource.data.dni)
        && request.resource.data.dni == dni;
      allow delete: if false;
    }

    // Cobros de créditos: cada pago registrado. Caja y Reportes los suman.
    // Solo el admin puede corregirlos o borrarlos.
    match /cobros/{id} {
      allow read, create: if logueado();
      allow update, delete: if esAdmin();
    }

    // Inventario de insumos: solo admin (leer, crear, editar, desactivar y eliminar).
    match /insumos/{id} {
      allow read, create, update, delete: if esAdmin();
    }

    // Movimientos de insumos (compras, salidas, ajustes): historial, nunca se
    // borra (ni siquiera al eliminar el insumo: guarda nombreInsumo).
    match /movimientosInsumos/{id} {
      allow read, create, update: if esAdmin();
      allow delete: if false;
    }

    // Trabajadores: solo admin, DNI válido. Se desactivan, no se borran.
    match /trabajadores/{id} {
      allow read: if esAdmin();
      allow create, update: if esAdmin() && dniOk(request.resource.data.dni);
      allow delete: if false;
    }

    // Pagos a trabajadores: historial, nunca se borra.
    match /pagosTrabajadores/{id} {
      allow read, create, update: if esAdmin();
      allow delete: if false;
    }

    // Egresos de caja (compras de insumos, ingresos de bebidas y pagos a
    // trabajadores pagados con efectivo de la caja). Los lee cualquier usuario logueado porque la Caja
    // la usa también el cajero; solo el admin los crea; nunca se modifican ni borran.
    match /egresos/{id} {
      allow read: if logueado();
      allow create: if esAdmin();
      allow update, delete: if false;
    }
  }
}
