rules_version = '2';

// ============================================================
// Reglas de seguridad de Cloud Firestore — ALANA POS
// Pegar completas en: Firebase > Firestore Database > Reglas > Publicar
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿Hay sesión iniciada?
    function logueado() {
      return request.auth != null;
    }

    // ¿El usuario logueado tiene rol "admin" en la colección usuarios?
    function esAdmin() {
      return logueado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // DNI válido: exactamente 8 números y no todos iguales (00000000, 11111111…).
    function dniOk(dni) {
      return dni is string
        && dni.matches('^[0-9]{8}$')
        && !(dni in ['00000000', '11111111', '22222222', '33333333', '44444444',
                     '55555555', '66666666', '77777777', '88888888', '99999999']);
    }

    // Perfiles: cada uno lee el suyo; el admin lee todos.
    // Se crean/editan solo desde la consola de Firebase.
    match /usuarios/{uid} {
      allow read: if logueado() && (request.auth.uid == uid || esAdmin());
      allow write: if false;
    }

    // Productos: todos los logueados leen; solo admin escribe.
    match /productos/{id} {
      allow read: if logueado();
      allow write: if esAdmin();
    }

    // Ventas: logueados leen y crean; solo admin anula (update) o borra.
    match /ventas/{id} {
      allow read, create: if logueado();
      allow update, delete: if esAdmin();
    }

    // Cierres de caja: logueados leen, abren (create) y cierran (update).
    match /cierres/{id} {
      allow read, create, update: if logueado();
      allow delete: if esAdmin();
    }

    // NUEVO: config/cajaActual guarda el id de la caja abierta para que
    // las 2 PCs compartan una sola caja. Cajeros y admin lo leen y lo
    // actualizan al abrir/cerrar caja; nadie lo borra.
    match /config/{id} {
      allow read: if logueado();
      allow create, update: if logueado();
      allow delete: if false;
    }

    // Créditos (ventas fiadas): son el respaldo ante reclamos, NUNCA se borran.
    // Pagados y anulados solo cambian de estado.
    // Al crear se exige DNI válido. Al actualizar (pagos, anulación) se acepta
    // si el DNI no cambia, para no bloquear créditos antiguos.
    match /creditos/{id} {
      allow read: if logueado();
      allow create: if logueado() && dniOk(request.resource.data.dni);
      allow update: if logueado()
        && (request.resource.data.dni == resource.data.dni || dniOk(request.resource.data.dni));
      allow delete: if false;
    }

    // Clientes (ID del documento = DNI válido). Nunca se borran.
    match /clientes/{dni} {
      allow read: if logueado();
      allow create, update: if logueado()
        && dniOk(request.resource.data.dni)
        && request.resource.data.dni == dni;
      allow delete: if false;
    }

    // Cobros de créditos: cada pago registrado. Caja y Reportes los suman.
    // Solo el admin puede corregirlos o borrarlos.
    match /cobros/{id} {
      allow read, create: if logueado();
      allow update, delete: if esAdmin();
    }
  }
}
